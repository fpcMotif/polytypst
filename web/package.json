{
  "name": "polytypst-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "varlock codegen",
    "env:check": "varlock load",
    "env:scan": "varlock scan",
    "dev": "vite",
    "typecheck": "bun check",
    "lint": "bun lint --type-aware src",
    "fmt": "bun fmt src convex vite.config.ts",
    "fmt:check": "bun fmt --check src convex vite.config.ts",
    "verify": "bun check && bun lint --type-aware src && bun fmt --check src convex vite.config.ts",
    "build": "bun check && vite build",
    "preview": "vite preview",
    "deploy:cf": "wrangler deploy"
  },
  "dependencies": {
    "convex": "^1.47.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@varlock/vite-integration": "^1.5.4",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "varlock": "^1.23.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
