amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

local linters = new Mapping {
    ["ruff"] {
        glob = "*.py"
        check = "uv run ruff check {{files}}"
        fix = "uv run ruff check --fix {{files}}"
    }
    ["rustfmt"] {
        glob = List("native/**/*.rs", "native/rustfmt.toml")
        check = "mbx fmt --manifest-path native/Cargo.toml --check"
        fix = "mbx fmt --manifest-path native/Cargo.toml"
    }
    ["clippy"] {
        glob = List("native/**/*.rs", "native/Cargo.toml", "native/clippy.toml")
        check = "mbx clippy --manifest-path native/Cargo.toml --release -- -D warnings"
        depends = List("rustfmt")
    }
    ["pytest"] {
        glob = List("*.py", "*.pkl", "quality/baseline.json", "native/**/*.rs")
        check = "uv run pytest -q --deselect tests/test_ocr_robustness.py::TestOCREngineMachine::runTest"
        depends = List("ruff")
    }
    ["canaries"] {
        glob = List("src/compiler/**/*.py")
        check = "scripts/canaries.sh"
        depends = List("pytest")
    }
    ["audit"] {
        glob = List("src/**/*.py", "quality/baseline.json")
        check = "uv run polytypst audit"
        depends = List("canaries")
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["commit-msg"] {
        steps {
            ["protected"] {
                check = "uv run python scripts/protected_paths.py --message-file {{commit_msg_file}}"
            }
        }
    }
    ["check"] {
        steps {
            ...linters
            ["protected"] {
                check = "uv run python scripts/protected_paths.py"
            }
        }
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
